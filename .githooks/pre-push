#!/bin/sh
# Scans every commit about to be pushed for secrets. Installed by scripts/install-hooks.ps1.
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-push: gitleaks not found on PATH; install it (winget install Gitleaks.Gitleaks)." >&2
    exit 1
fi

zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha --not --remotes"
    else
        range="$remote_sha..$local_sha"
    fi
    gitleaks git --log-opts="$range" --redact --no-banner || status=1
done
exit $status
