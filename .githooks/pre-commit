#!/bin/sh
# Blocks commits that contain secrets. Installed by scripts/install-hooks.ps1.
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks not found on PATH; install it (winget install Gitleaks.Gitleaks)." >&2
    exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
